{
  "manifest_version": 3,
  "name": "Jarvis — navegador",
  "description": "Conecte este navegador ao Jarvis para navegar e inspecionar páginas durante suas conversas.",
  "version": "1.0.0",
  "minimum_chrome_version": "125",
  "icons": { "16": "icons/32.png", "32": "icons/32.png", "48": "icons/64.png", "128": "icons/128.png" },
  "permissions": ["debugger", "tabs", "storage", "alarms"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_title": "Conectar ao Jarvis", "default_icon": { "16": "icons/32.png", "32": "icons/32.png" } },
  "options_page": "options.html",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*" }
}
