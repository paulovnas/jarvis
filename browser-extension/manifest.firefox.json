{
  "manifest_version": 3,
  "name": "Jarvis — navegador",
  "description": "Conecte o Firefox ao Jarvis para navegar e inspecionar páginas durante suas conversas.",
  "version": "1.2.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser@jarvis.foxtag.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["browsingActivity", "websiteContent", "websiteActivity"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "icons": { "32": "icons/32.png", "64": "icons/64.png", "128": "icons/128.png" },
  "permissions": ["tabs", "storage", "alarms", "scripting", "webNavigation", "webRequest", "webRequestBlocking", "webRequestFilterResponse"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["worker.js"], "type": "module", "persistent": false },
  "action": { "default_title": "Conectar ao Jarvis", "default_icon": { "32": "icons/32.png" } },
  "options_page": "options.html",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*" }
}
