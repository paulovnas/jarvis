{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "1.9.6",
  "identifier": "com.foxtag.jarvis",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Jarvis",
        "visible": false,
        "width": 1360,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 480,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "Entitlements.plist"
    },
    "resources": {
      "../browser-extension/dist/": "browser-extension/",
      "../browser-extension/dist-firefox/": "browser-extension-firefox/",
      "resources/jarvito/announcements/": "jarvito/announcements/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3NTVBNTk0ODJGMEZDOUMKUldTYy9QQ0NsS1ZWVjNLVUUxa1J3OEdrK3lxU1dpVFd4cFB1eXh0b0NkQUhDMTduZTFIOE8vaksK"
    }
  }
}
