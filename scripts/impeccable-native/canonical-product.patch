+        roots.product_path = Some(root.join("app/PRODUCT.md").to_string_lossy().into_owned());
+        assert!(!crate::server_state::resolve_project_context(&roots.app_root, &env, Some(&roots)).has_product);
+        let RootsResult::Manifest(resolved) = resolve_roots(&root.to_string_lossy(), Some("app"), &env) else { panic!("expected configured app") };
+        assert_eq!(resolved.product_path, None);
