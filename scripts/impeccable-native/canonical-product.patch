+        fs::write(root.join("app/PRODUCT.md"), "# Competing child").unwrap();
+        fs::write(root.join("app/package.json"), "{}").unwrap();
+        fs::write(root.join("app/vite.config.ts"), "export default {}").unwrap();
+        fs::write(root.join(".jarvis/knowledge/prd.md"), "# Canonical product").unwrap();
+        let root = fs::canonicalize(root).unwrap();
+        let product = root.join(".jarvis/knowledge/prd.md");
+        let env = Env::from([
+            (impeccable_common::product::ROOT_ENV.into(), root.to_string_lossy().into_owned()),
