--- /dev/null
+++ b/crates/common/src/product.rs
@@ -0,0 +1,43 @@
+//! Optional execution-private product binding for native hosts. No project file is copied.
+use std::collections::HashMap;
+
+pub const PATH_ENV: &str = "IMPECCABLE_PRODUCT_PATH";
+pub const ROOT_ENV: &str = "IMPECCABLE_PRODUCT_ROOT";
+
+pub fn resolve(cwd: &str, env: &HashMap<String, String>) -> Result<Option<String>, String> {
+    crate::design::resolve_document(cwd, env, PATH_ENV, ROOT_ENV, "produto")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{fs, path::PathBuf};
+
+    #[test]
+    fn product_binding_uses_the_same_containment_validation_without_copying() {
+        let root: PathBuf = std::env::temp_dir().join(format!(
+            "impeccable-product-binding-{}-{:?}", std::process::id(), std::thread::current().id()
+        ));
+        fs::create_dir_all(root.join("app")).unwrap();
+        fs::create_dir_all(root.join(".jarvis/knowledge")).unwrap();
+        fs::write(root.join(".jarvis/knowledge/prd.md"), "# Canonical product").unwrap();
+        let root = fs::canonicalize(root).unwrap();
+        let canonical = root.join(".jarvis/knowledge/prd.md");
+        let mut env = HashMap::from([
+            (ROOT_ENV.into(), root.to_string_lossy().into_owned()),
+            (PATH_ENV.into(), canonical.to_string_lossy().into_owned()),
+        ]);
+        assert_eq!(resolve(&root.join("app").to_string_lossy(), &env).unwrap(), Some(canonical.to_string_lossy().into_owned()));
+        assert!(!root.join("PRODUCT.md").exists());
+        assert_eq!(resolve(&root.to_string_lossy(), &HashMap::new()).unwrap(), None);
+        env.insert(PATH_ENV.into(), "prd.md".into());
+        assert!(resolve(&root.to_string_lossy(), &env).unwrap_err().contains(PATH_ENV));
+        env.insert(PATH_ENV.into(), canonical.to_string_lossy().into_owned());
+        env.remove(ROOT_ENV);
+        assert!(resolve(&root.to_string_lossy(), &env).unwrap_err().contains(ROOT_ENV));
+        env.insert(ROOT_ENV.into(), root.to_string_lossy().into_owned());
+        fs::remove_file(canonical).unwrap();
+        assert!(resolve(&root.to_string_lossy(), &env).unwrap_err().contains("produto"));
+        fs::remove_dir_all(root).unwrap();
+    }
+}
