+//! Optional execution-private design binding for native hosts. No project file is copied.
+use std::{collections::HashMap, fs, path::Path};
+
+pub const PATH_ENV: &str = "IMPECCABLE_DESIGN_PATH";
+pub const ROOT_ENV: &str = "IMPECCABLE_DESIGN_ROOT";
+
+/// Both paths are host-owned. A configured but unusable document is an error,
+/// never authorization to rediscover a different root DESIGN.md.
+pub fn resolve(cwd: &str, env: &HashMap<String, String>) -> Result<Option<String>, String> {
+    let Some(value) = env.get(PATH_ENV) else {
+        return Ok(None);
+    };
+    let path = Path::new(value);
+    if value.is_empty()
+        || value.contains('\0')
+        || !path.is_absolute()
+        || !path
+            .extension()
+            .and_then(|ext| ext.to_str())
+            .is_some_and(|ext| ext.eq_ignore_ascii_case("md"))
+    {
+        return Err(
+            "IMPECCABLE_DESIGN_PATH deve apontar para um arquivo Markdown absoluto.".into(),
+        );
+    }
+    let root_value = env
+        .get(ROOT_ENV)
+        .filter(|root| !root.is_empty() && !root.contains('\0'))
+        .ok_or("IMPECCABLE_DESIGN_ROOT não foi definido para o documento canônico.")?;
+    let root_path = Path::new(root_value);
+    if !root_path.is_absolute() {
+        return Err("IMPECCABLE_DESIGN_ROOT deve ser uma pasta absoluta.".into());
+    }
+    let root = fs::canonicalize(root_path)
+        .map_err(|_| "A raiz do documento de design não está disponível.")?;
+    let cwd = fs::canonicalize(cwd)
+        .map_err(|_| "A pasta de execução do Impeccable não está disponível.")?;
+    if !root.is_dir() || !cwd.is_dir() || !cwd.starts_with(&root) {
+        return Err("A execução do Impeccable está fora da raiz de design configurada.".into());
+    }
+    let file = fs::canonicalize(path)
+        .map_err(|_| "O documento de design configurado não existe ou não pode ser acessado.")?;
+    if !file.is_file() || !file.starts_with(&root) {
+        return Err("O documento de design deve ser um arquivo dentro da raiz configurada.".into());
+    }
+    let file = file
+        .to_str()
+        .ok_or("O caminho do documento de design não é UTF-8.")?;
+    // Node's Live assets need ordinary Win32 paths, not verbatim canonical paths.
+    let file = if let Some(unc) = file.strip_prefix(r"\\?\UNC\") {
+        format!(r"\\{unc}")
+    } else {
+        file.strip_prefix(r"\\?\").unwrap_or(file).to_string()
+    };
+    Ok(Some(file))
+}
