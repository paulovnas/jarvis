+        assert_eq!(fs::canonicalize(roots.design_path.as_ref().unwrap()).unwrap(), fs::canonicalize(&env[impeccable_common::design::PATH_ENV]).unwrap());
+        let ctx = crate::server_state::resolve_project_context(&roots.app_root, &env, Some(&roots));
+        assert_eq!(ctx.resolved_design_path, roots.design_path);
+        let md = fs::read_to_string(ctx.resolved_design_path.unwrap()).unwrap();
+        let parsed = crate::design_md::parse_design_md(&md).unwrap();
+        assert_eq!(parsed["frontmatter"]["colors"]["primary"], "#123456");
+        assert_eq!(parsed["frontmatter"]["name"], "Canonical");
+        assert_eq!(fs::read_to_string(fixture.0.join("app/DESIGN.md")).unwrap(), "# Competing child");
+    }
+    #[test]
+    fn canonical_design_live_roots_do_not_fall_back_when_registered_file_is_missing() {
+        let fixture = Fixture::new();
+        fs::remove_file(fixture.0.join(".jarvis/knowledge/design.md")).unwrap();
+        let RootsResult::Manifest(mut roots) = resolve_roots(&fixture.0.to_string_lossy(), Some("app"), &fixture.env()) else { panic!("expected configured app") };
+        assert_eq!(roots.design_path, None);
+        roots.design_path = Some(fixture.0.join("app/DESIGN.md").to_string_lossy().into_owned());
+        let ctx = crate::server_state::resolve_project_context(&roots.app_root, &fixture.env(), Some(&roots));
+        assert_eq!(ctx.resolved_design_path, None);
+    }
+}
