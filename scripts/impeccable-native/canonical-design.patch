+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    static NEXT: AtomicUsize = AtomicUsize::new(0);
+    struct Fixture(std::path::PathBuf);
+    impl Fixture {
+        fn new() -> Self {
+            let path = std::env::temp_dir().join(format!(
+                "impeccable-canonical-design-{}-{}",
+                std::process::id(),
+                NEXT.fetch_add(1, Ordering::Relaxed)
+            ));
+            fs::create_dir_all(path.join("app")).unwrap();
+            fs::create_dir_all(path.join(".jarvis/knowledge")).unwrap();
+            fs::write(path.join(".jarvis/knowledge/design.md"), "# Canonical").unwrap();
+            Self(fs::canonicalize(path).unwrap())
+        }
+        fn env(&self) -> HashMap<String, String> {
+            HashMap::from([
+                (ROOT_ENV.into(), self.0.to_string_lossy().into_owned()),
+                (
+                    PATH_ENV.into(),
+                    self.0
+                        .join(".jarvis/knowledge/design.md")
+                        .to_string_lossy()
+                        .into_owned(),
+                ),
+            ])
+        }
+        fn cwd(&self) -> String {
+            self.0.to_string_lossy().into_owned()
+        }
+    }
+    impl Drop for Fixture {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.0);
+        }
+    }
+
+    #[test]
+    fn canonical_design_binding_survives_child_app_cwd_without_copying() {
+        let fixture = Fixture::new();
+        let path = resolve(&fixture.cwd(), &fixture.env()).unwrap().unwrap();
+        assert!(
+            Path::new(&path).ends_with(Path::new(".jarvis").join("knowledge").join("design.md"))
+        );
+        assert_eq!(
+            resolve(&fixture.0.join("app").to_string_lossy(), &fixture.env()).unwrap(),
+            Some(path)
+        );
+        assert!(!fixture.0.join("DESIGN.md").exists());
+        assert_eq!(resolve(&fixture.cwd(), &HashMap::new()).unwrap(), None);
+    }
+
+    #[test]
+    fn canonical_design_rejects_missing_relative_unbound_and_cross_project_files() {
+        let fixture = Fixture::new();
+        let external = Fixture::new();
+        let mut env = fixture.env();
+        env.insert(PATH_ENV.into(), "design.md".into());
+        assert!(resolve(&fixture.cwd(), &env)
+            .unwrap_err()
+            .contains("absoluto"));
+        env = fixture.env();
+        env.remove(ROOT_ENV);
+        assert!(resolve(&fixture.cwd(), &env)
+            .unwrap_err()
+            .contains(ROOT_ENV));
+        env = fixture.env();
+        env.insert(PATH_ENV.into(), external.env()[PATH_ENV].clone());
+        assert!(resolve(&fixture.cwd(), &env)
+            .unwrap_err()
+            .contains("dentro da raiz"));
+        assert!(resolve(&external.cwd(), &fixture.env())
+            .unwrap_err()
+            .contains("fora da raiz"));
+        fs::remove_file(fixture.0.join(".jarvis/knowledge/design.md")).unwrap();
+        assert!(resolve(&fixture.cwd(), &fixture.env())
+            .unwrap_err()
+            .contains("não existe"));
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn canonical_design_rejects_a_symlink_escape() {
+        let fixture = Fixture::new();
+        let external = Fixture::new();
+        let file = fixture.0.join(".jarvis/knowledge/design.md");
+        fs::remove_file(&file).unwrap();
+        std::os::unix::fs::symlink(external.env()[PATH_ENV].clone(), file).unwrap();
+        assert!(resolve(&fixture.cwd(), &fixture.env())
+            .unwrap_err()
+            .contains("dentro da raiz"));
+    }
+}
