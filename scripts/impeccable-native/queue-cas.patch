+        let event = json!({"id":"action","type":"steer","message":"Teste"});
+        assert_eq!(
+            identity(
+                "action",
+                &journal(&[
+                    event.clone(),
+                    json!({"id":"action","type":"steer_done"}),
+                    event
+                ])
+            ),
+            Some((3, Some(3)))
+        );
+    }
+
+    #[test]
+    fn jarvis_cas_rejects_corrupt_or_wrong_action_journal() {
+        assert_eq!(
+            identity(
+                "different",
+                &journal(&[json!({"id":"action","type":"steer"})])
+            ),
+            None
+        );
+        assert_eq!(identity("action", b"not json\n"), None);
+    }
+    #[test]
+    fn jarvis_cas_cancel_checks_current_pending_sequence_and_never_writes_journal() {
+        let directory = std::env::temp_dir().join(format!(
+            "jarvis-cas-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        std::fs::create_dir(&directory).unwrap();
+        let store = SessionStore {
+            root_dir: directory.to_string_lossy().into_owned(),
+            legacy_root_dir: directory.join("legacy").to_string_lossy().into_owned(),
+            session_id: None,
+        };
+        let event = json!({"id":"action","type":"generate","freeformPrompt":"Badge"});
+        let mut enriched = event.clone();
+        enriched["generationReadyAt"] = json!(123);
+        let bytes = journal(&[
+            event,
+            enriched,
+            json!({"id":"action","type":"accept","chosen":1}),
+        ]);
+        let file = directory.join("action.jsonl");
+        std::fs::write(&file, &bytes).unwrap();
+        assert!(matches(&store, "action", 1, None));
+        assert!(!matches(&store, "action", 1, Some(2)));
+        assert!(matches(&store, "action", 1, Some(3)));
+        assert!(!matches(&store, "action", 2, Some(3)));
+        assert_eq!(std::fs::read(file).unwrap(), bytes);
+        std::fs::remove_dir_all(directory).unwrap();
+    }
