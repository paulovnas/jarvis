+        let mut env = Env::new();
+        let mut body = json!({"id":"action","type":"complete","sourceEventType":"accept"});
+        assert!(!bind_reply(&mut body, &env).unwrap());
+        env.insert("JARVIS_LIVE_REQUEST_SEQ".into(), "7".into());
+        assert!(bind_reply(&mut body, &env).is_err());
+        env.insert("JARVIS_LIVE_EVENT_TYPE".into(), "accept".into());
+        assert!(bind_reply(&mut body, &env).unwrap());
+        assert_eq!(body["jarvisRequestSeq"], 7);
+        assert_eq!(body["jarvisEventType"], "accept");
+        assert_eq!(body["sourceEventType"], "accept");
+    }
