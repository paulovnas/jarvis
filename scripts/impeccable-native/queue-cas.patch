+//! Optional Jarvis host admission/cancellation fencing. Upstream callers keep
+//! their original protocol; guarded host requests never cross a human revision.
+use crate::{session::SessionStore, util::Env};
+use serde_json::Value;
+use std::{fs, io::Read, path::Path};
+
+const MAX_JOURNAL: u64 = 2 * 1024 * 1024;
+const MAX_ENTRY: usize = 256 * 1024;
+
+fn same_submission(left: &Value, right: &Value) -> bool {
+    [
+        "type",
+        "id",
+        "action",
+        "freeformPrompt",
+        "prompt",
+        "message",
+        "clientSentAt",
+        "pageUrl",
+        "element",
+        "count",
+    ]
+    .iter()
+    .all(|key| left.get(key) == right.get(key))
+}
+
+/// The first human sequence is stable across scaffold enrichment. The pending
+/// sequence also changes for lifecycle events, fencing an old cancellation.
+fn identity(id: &str, bytes: &[u8]) -> Option<(u64, Option<u64>)> {
+    let text = std::str::from_utf8(bytes).ok()?;
+    let mut previous = 0;
+    let mut request: Option<(u64, Value)> = None;
+    let mut pending = None;
+    let mut finalized = false;
+    for line in text.lines().filter(|line| !line.trim().is_empty()) {
+        if line.len() > MAX_ENTRY {
+            return None;
+        }
+        let record: Value = serde_json::from_str(line).ok()?;
+        let seq = record["seq"].as_u64().filter(|seq| *seq > previous)?;
+        let event = record.get("event").filter(|event| event.is_object())?;
+        let kind = event["type"].as_str()?;
+        if record["id"] != id || event["id"] != id || record["type"] != kind {
+            return None;
+        }
+        previous = seq;
+        match kind {
+            "generate" | "steer" | "manual_edit_apply" | "variant_mount_failed" => {
+                if finalized
+                    || !request
+                        .as_ref()
+                        .is_some_and(|(_, prior)| same_submission(prior, event))
+                {
+                    request = Some((seq, event.clone()));
+                }
+                pending = Some(seq);
+                finalized = false;
+            }
+            "accept" | "discard" | "carbonize_cleanup" => {
+                if request.is_none() {
+                    request = Some((seq, event.clone()));
+                }
+                pending = Some(seq);
+                finalized = false;
+            }
+            "agent_done" | "steer_done" | "variants_ready" | "complete" | "discarded"
+            | "agent_error" => {
+                pending = None;
+                finalized = true;
+            }
+            _ => {}
+        }
+    }
+    request.map(|(seq, _)| (seq, pending))
+}
+
+/// Attach the immutable host binding to CLI acknowledgements. A host-bound
+/// command cannot fall back to an unguarded local journal append.
+pub(crate) fn bind_reply(body: &mut Value, env: &Env) -> Result<bool, String> {
+    let Some(raw) = env.get("JARVIS_LIVE_REQUEST_SEQ") else {
+        return Ok(false);
+    };
+    let seq = raw
+        .parse::<u64>()
+        .ok()
+        .filter(|seq| *seq > 0)
+        .ok_or_else(|| "invalid_jarvis_request".to_string())?;
+    let kind = env
+        .get("JARVIS_LIVE_EVENT_TYPE")
+        .filter(|kind| !kind.is_empty())
+        .ok_or_else(|| "invalid_jarvis_request".to_string())?;
+    let pending = env
+        .get("JARVIS_LIVE_PENDING_EVENT_SEQ")
+        .and_then(|raw| raw.parse::<u64>().ok())
+        .filter(|seq| *seq > 0)
+        .ok_or_else(|| "invalid_jarvis_request".to_string())?;
+    body["jarvisRequestSeq"] = Value::from(seq);
+    body["jarvisPendingEventSeq"] = Value::from(pending);
+    body["jarvisEventType"] = Value::from(kind.as_str());
+    Ok(true)
+}
+
+/// Called with the live server mutex held, before leases, acknowledgements,
+/// manual apply resolution or source rollback. No canonical files are written.
+pub(crate) fn matches(
+    store: &SessionStore,
+    id: &str,
+    request_seq: u64,
+    pending_seq: Option<u64>,
+) -> bool {
+    read_journal(store, id).is_some_and(|bytes| {
+        identity(id, &bytes).is_some_and(|(current, pending)| {
+            current == request_seq && pending_seq.is_none_or(|expected| pending == Some(expected))
+        })
+    })
+}
+
+fn read_journal(store: &SessionStore, id: &str) -> Option<Vec<u8>> {
+    if id.is_empty()
+        || id.len() > 128
+        || !id
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_'))
+    {
+        return None;
+    }
+    for directory in [&store.root_dir, &store.legacy_root_dir] {
+        let directory = Path::new(directory);
+        let path = directory.join(format!("{id}.jsonl"));
+        let Ok(meta) = fs::symlink_metadata(&path) else {
+            continue;
+        };
+        if meta.is_symlink() || !meta.is_file() || meta.len() > MAX_JOURNAL {
+            return None;
+        }
+        let (Ok(root), Ok(canonical)) = (directory.canonicalize(), path.canonicalize()) else {
+            return None;
+        };
+        if canonical.parent() != Some(root.as_path()) {
+            return None;
+        }
+        let mut options = fs::OpenOptions::new();
+        options.read(true);
+        let Ok(file) = options.open(&path) else {
+            return None;
+        };
+        let mut bytes = Vec::new();
+        if file.take(MAX_JOURNAL + 1).read_to_end(&mut bytes).is_err()
+            || bytes.len() as u64 > MAX_JOURNAL
+        {
+            return None;
+        }
+        return Some(bytes);
+    }
+    None
+}
+
+fn records(id: &str, bytes: &[u8]) -> Option<Vec<(u64, Value)>> {
+    identity(id, bytes)?;
+    std::str::from_utf8(bytes)
+        .ok()?
+        .lines()
+        .filter(|line| !line.trim().is_empty())
+        .map(|line| {
+            let record: Value = serde_json::from_str(line).ok()?;
+            Some((record["seq"].as_u64()?, record["event"].clone()))
+        })
+        .collect()
+}
+
+/// A cleanup belongs to the last durable browser choice, never a client field.
+pub(crate) fn choice_seq(store: &SessionStore, id: &str) -> Option<u64> {
+    let bytes = read_journal(store, id)?;
+    let records = records(id, &bytes)?;
+    records
+        .iter()
+        .rev()
+        .find(|(_, event)| matches!(event["type"].as_str(), Some("accept" | "discard")))
+        .filter(|(_, event)| event["type"] == "accept")
+        .map(|(seq, _)| *seq)
+}
+
+/// Acknowledgements fence the leased phase, with only host-owned enrichment
+/// and the accepted choice's cleanup allowed to advance that phase.
+pub(crate) fn reply_matches(
+    store: &SessionStore,
+    id: &str,
+    request_seq: u64,
+    pending_seq: u64,
+    kind: &str,
+    reply_kind: &str,
+) -> bool {
+    let Some(bytes) = read_journal(store, id) else {
+        return false;
+    };
+    let Some((current_request, current_pending)) = identity(id, &bytes) else {
+        return false;
+    };
+    if current_request != request_seq {
+        return false;
+    }
+    let Some(records) = records(id, &bytes) else {
+        return false;
+    };
+    let Some((_, source)) = records.iter().find(|(seq, _)| *seq == pending_seq) else {
+        return false;
+    };
+    if source["type"].as_str() != Some(kind) {
+        return false;
+    }
+    if current_pending == Some(pending_seq) {
+        return true;
+    }
+    let later = records.iter().filter(|(seq, _)| *seq > pending_seq);
+    if matches!(kind, "generate" | "steer") && current_pending.is_some() {
+        return later
+            .clone()
+            .all(|(_, event)| match event["type"].as_str().unwrap_or("") {
+                "generate" | "steer" => same_submission(source, event),
+                "accept"
+                | "discard"
+                | "carbonize_cleanup"
+                | "manual_edit_apply"
+                | "variant_mount_failed"
+                | "agent_done"
+                | "steer_done"
+                | "variants_ready"
+                | "complete"
+                | "discarded"
+                | "agent_error" => false,
+                _ => true,
+            });
+    }
+    if kind != "accept" || !matches!(reply_kind, "complete" | "error" | "agent_done" | "done") {
+        return false;
+    }
+    let last_choice = records
+        .iter()
+        .rev()
+        .find(|(_, event)| matches!(event["type"].as_str(), Some("accept" | "discard")));
+    if last_choice.map(|(seq, _)| *seq) != Some(pending_seq) {
+        return false;
+    }
+    let mut final_complete = false;
+    let mut accept_ack = false;
+    let mut cleanup_pending = false;
+    for (_, event) in later {
+        match event["type"].as_str().unwrap_or("") {
+            "carbonize_cleanup" if !final_complete => {
+                if event
+                    .get("_jarvisChoiceEventSeq")
+                    .is_some_and(|seq| seq.as_u64() != Some(pending_seq))
+                    || event["sessionId"] != id
+                    || event["variantId"] != source["variantId"]
+                {
+                    return false;
+                }
+                cleanup_pending = true;
+            }
+            "agent_done" if !final_complete => {
+                if !matches!(
+                    event["sourceEventType"].as_str(),
+                    Some("accept" | "carbonize_cleanup")
+                ) {
+                    return false;
+                }
+                accept_ack = true;
+                cleanup_pending = false;
+            }
+            "complete" => {
+                if !matches!(
+                    event["sourceEventType"].as_str(),
+                    Some("accept" | "carbonize_cleanup")
+                ) {
+                    return false;
+                }
+                final_complete = true;
+                cleanup_pending = false;
+            }
+            "generate"
+            | "steer"
+            | "manual_edit_apply"
+            | "variant_mount_failed"
+            | "accept"
+            | "discard"
+            | "carbonize_cleanup"
+            | "agent_done"
+            | "steer_done"
+            | "variants_ready"
+            | "discarded"
+            | "agent_error" => return false,
+            _ => {}
+        }
+    }
+    if current_pending.is_some() {
+        return cleanup_pending && !final_complete;
+    }
+    (accept_ack && !final_complete) || (final_complete && reply_kind == "complete")
+}
+
+/// A reused action ID can leave an older in-memory queue payload because
+/// upstream deduplicates id+type. Reconcile only against its canonical snapshot.
+pub(crate) fn pending(store: &SessionStore, id: &str) -> Option<serde_json::Map<String, Value>> {
+    let mut event = store
+        .read_state(id, false)
+        .ok()?
+        .snapshot
+        .get("pendingEvent")?
+        .as_object()
+        .cloned()?;
+    event.insert(
+        "_jarvisPendingEventSeq".into(),
+        Value::from(pending_seq(store, id)?),
+    );
+    Some(event)
+}
+
+pub(crate) fn pending_seq(store: &SessionStore, id: &str) -> Option<u64> {
+    let bytes = read_journal(store, id)?;
+    identity(id, &bytes)?.1
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn journal(events: &[Value]) -> Vec<u8> {
+        events
+            .iter()
+            .enumerate()
+            .map(|(index, event)| {
+                format!(
+                    "{}\n",
+                    json!({"seq":index + 1,"id":"action","type":event["type"],"event":event})
+                )
+            })
+            .collect::<String>()
+            .into_bytes()
+    }
+
+    #[test]
+    fn jarvis_cas_same_action_new_human_request_is_not_old_request() {
+        let bytes = journal(&[
+            json!({"id":"action","type":"generate","freeformPrompt":"Badge"}),
+            json!({"id":"action","type":"generate","freeformPrompt":"Ícones"}),
+        ]);
+        assert_eq!(identity("action", &bytes), Some((2, Some(2))));
+    }
+
+    #[test]
+    fn jarvis_cas_enrichment_preserves_human_identity_but_advances_pending() {
+        let event = json!({"id":"action","type":"generate","freeformPrompt":"Badge"});
+        let mut enriched = event.clone();
+        enriched["generationReadyAt"] = json!(123);
+        assert_eq!(
+            identity("action", &journal(&[event, enriched])),
+            Some((1, Some(2)))
+        );
+    }
+
+    #[test]
+    fn jarvis_cas_lifecycle_and_completed_ack_cannot_clear_new_pending() {
+        let start = json!({"id":"action","type":"generate","freeformPrompt":"Badge"});
+        let done = json!({"id":"action","type":"agent_done"});
+        let accept = json!({"id":"action","type":"accept","chosen":1});
+        assert_eq!(
+            identity("action", &journal(&[start.clone(), done.clone()])),
+            Some((1, None))
+        );
+        assert_eq!(
+            identity("action", &journal(&[start, done, accept])),
+            Some((1, Some(3)))
+        );
+    }
+
+    #[test]
+    fn jarvis_cas_repeated_prompt_after_completion_is_new_human_request() {
+        let event = json!({"id":"action","type":"steer","message":"Teste"});
+        assert_eq!(
+            identity(
+                "action",
+                &journal(&[
+                    event.clone(),
+                    json!({"id":"action","type":"steer_done"}),
+                    event
+                ])
+            ),
+            Some((3, Some(3)))
+        );
+    }
+
+    #[test]
+    fn jarvis_cas_rejects_corrupt_or_wrong_action_journal() {
+        assert_eq!(
+            identity(
+                "different",
+                &journal(&[json!({"id":"action","type":"steer"})])
+            ),
+            None
+        );
+        assert_eq!(identity("action", b"not json\n"), None);
+    }
+    #[test]
+    fn jarvis_cas_cancel_checks_current_pending_sequence_and_never_writes_journal() {
+        let directory = std::env::temp_dir().join(format!(
+            "jarvis-cas-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        std::fs::create_dir(&directory).unwrap();
+        let store = SessionStore {
+            root_dir: directory.to_string_lossy().into_owned(),
+            legacy_root_dir: directory.join("legacy").to_string_lossy().into_owned(),
+            session_id: None,
+        };
+        let event = json!({"id":"action","type":"generate","freeformPrompt":"Badge"});
+        let mut enriched = event.clone();
+        enriched["generationReadyAt"] = json!(123);
+        let bytes = journal(&[
+            event,
+            enriched,
+            json!({"id":"action","type":"accept","chosen":1}),
+        ]);
+        let file = directory.join("action.jsonl");
+        std::fs::write(&file, &bytes).unwrap();
+        assert!(matches(&store, "action", 1, None));
+        assert!(!matches(&store, "action", 1, Some(2)));
+        assert!(matches(&store, "action", 1, Some(3)));
+        assert!(!matches(&store, "action", 2, Some(3)));
+        assert_eq!(std::fs::read(file).unwrap(), bytes);
+        std::fs::remove_dir_all(directory).unwrap();
+    }
+
+    #[test]
+    fn jarvis_cas_cli_host_binding_is_required_and_keeps_reply_source_metadata() {
+        let mut env = Env::new();
+        let mut body = json!({"id":"action","type":"complete","sourceEventType":"accept"});
+        assert!(!bind_reply(&mut body, &env).unwrap());
+        env.insert("JARVIS_LIVE_REQUEST_SEQ".into(), "7".into());
+        assert!(bind_reply(&mut body, &env).is_err());
+        env.insert("JARVIS_LIVE_EVENT_TYPE".into(), "accept".into());
+        assert!(bind_reply(&mut body, &env).is_err());
+        env.insert("JARVIS_LIVE_PENDING_EVENT_SEQ".into(), "9".into());
+        assert!(bind_reply(&mut body, &env).unwrap());
+        assert_eq!(body["jarvisRequestSeq"], 7);
+        assert_eq!(body["jarvisPendingEventSeq"], 9);
+        assert_eq!(body["jarvisEventType"], "accept");
+        assert_eq!(body["sourceEventType"], "accept");
+    }
+
+    fn with_journal(events: &[Value], test: impl FnOnce(&SessionStore)) {
+        let directory = std::env::temp_dir().join(format!(
+            "jarvis-cas-phase-{}-{:?}",
+            std::process::id(),
+            std::thread::current().id()
+        ));
+        std::fs::create_dir_all(&directory).unwrap();
+        let store = SessionStore {
+            root_dir: directory.to_string_lossy().into_owned(),
+            legacy_root_dir: directory.join("legacy").to_string_lossy().into_owned(),
+            session_id: None,
+        };
+        let bytes = journal(events);
+        let file = directory.join("action.jsonl");
+        std::fs::write(&file, &bytes).unwrap();
+        test(&store);
+        assert_eq!(std::fs::read(file).unwrap(), bytes);
+        std::fs::remove_dir_all(directory).unwrap();
+    }
+
+    #[test]
+    fn jarvis_cas_old_accept_ack_never_clears_a_new_choice_from_the_same_human() {
+        with_journal(
+            &[
+                json!({"id":"action","type":"generate","freeformPrompt":"Badge"}),
+                json!({"id":"action","type":"agent_done"}),
+                json!({"id":"action","type":"accept","variantId":"1"}),
+                json!({"id":"action","type":"accept","variantId":"2"}),
+            ],
+            |store| {
+                assert!(!reply_matches(store, "action", 1, 3, "accept", "complete"));
+                assert!(reply_matches(store, "action", 1, 4, "accept", "complete"));
+                assert_eq!(choice_seq(store, "action"), Some(4));
+                assert_eq!(
+                    pending(store, "action").unwrap()["_jarvisPendingEventSeq"],
+                    4
+                );
+            },
+        );
+    }
+
+    #[test]
+    fn jarvis_cas_accept_ack_survives_its_owned_cleanup_and_completion_only() {
+        let mut events = vec![
+            json!({"id":"action","type":"generate","freeformPrompt":"Badge"}),
+            json!({"id":"action","type":"agent_done"}),
+            json!({"id":"action","type":"accept","variantId":"2"}),
+            json!({"id":"action","type":"agent_done","sourceEventType":"accept","carbonize":true}),
+        ];
+        with_journal(&events, |store| {
+            assert!(reply_matches(store, "action", 1, 3, "accept", "complete"))
+        });
+        events.push(json!({"id":"action","type":"carbonize_cleanup","sessionId":"action","variantId":"2","file":"index.html","_jarvisChoiceEventSeq":3}));
+        with_journal(&events, |store| {
+            assert!(reply_matches(store, "action", 1, 3, "accept", "complete"));
+            assert!(!matches(store, "action", 1, Some(3)));
+        });
+        events.push(json!({"id":"action","type":"complete","sourceEventType":"carbonize_cleanup"}));
+        with_journal(&events, |store| {
+            assert!(reply_matches(store, "action", 1, 3, "accept", "complete"))
+        });
+        events.push(json!({"id":"action","type":"accept","variantId":"1"}));
+        with_journal(&events, |store| {
+            assert!(!reply_matches(store, "action", 1, 3, "accept", "complete"))
+        });
+    }
+
+    #[test]
+    fn jarvis_cas_accept_cleanup_cannot_cross_discard_cancellation_or_wrong_choice() {
+        let base = vec![
+            json!({"id":"action","type":"generate","freeformPrompt":"Badge"}),
+            json!({"id":"action","type":"agent_done"}),
+            json!({"id":"action","type":"accept","variantId":"2"}),
+        ];
+        for boundary in [
+            json!({"id":"action","type":"discard"}),
+            json!({"id":"action","type":"agent_error","sourceEventType":"accept"}),
+        ] {
+            let mut events = base.clone();
+            events.push(boundary);
+            events.push(json!({"id":"action","type":"carbonize_cleanup","sessionId":"action","variantId":"2","file":"index.html","_jarvisChoiceEventSeq":3}));
+            with_journal(&events, |store| {
+                assert!(!reply_matches(store, "action", 1, 3, "accept", "complete"))
+            });
+        }
+        let mut events = base;
+        events.push(json!({"id":"action","type":"carbonize_cleanup","sessionId":"action","variantId":"1","file":"index.html","_jarvisChoiceEventSeq":3}));
+        with_journal(&events, |store| {
+            assert!(!reply_matches(store, "action", 1, 3, "accept", "complete"))
+        });
+    }
+
+    #[test]
+    fn jarvis_cas_enriched_generation_and_steer_keep_their_ack_without_crossing_lifecycle() {
+        for (kind, reply) in [("generate", "done"), ("steer", "steer_done")] {
+            let source =
+                json!({"id":"action","type":kind,"freeformPrompt":"Badge","message":"Badge"});
+            let mut enriched = source.clone();
+            enriched["scaffoldAttempted"] = json!(true);
+            with_journal(&[source.clone(), enriched.clone()], |store| {
+                assert!(reply_matches(store, "action", 1, 1, kind, reply))
+            });
+            with_journal(
+                &[
+                    source,
+                    json!({"id":"action","type":"accept","variantId":"1"}),
+                    enriched,
+                ],
+                |store| assert!(!reply_matches(store, "action", 1, 1, kind, reply)),
+            );
+        }
+    }
+}
