 /// JS: resolveProjectContext(): PRODUCT.md / DESIGN.md truth resolved per
 /// request, roots manifest as fallback.
+fn host_design(cwd: &str, env: &Env) -> Result<Option<String>, String> {
+    use std::{fs, io::Read, path::Path};
+    let owner_path = env.get("JARVIS_LIVE_OWNER_PATH").ok_or("Missing Live owner binding")?;
+    let owner_path = Path::new(owner_path);
+    let metadata = fs::symlink_metadata(owner_path).map_err(|_| "Live owner binding unavailable")?;
+    if !owner_path.is_absolute() || !metadata.is_file() || metadata.is_symlink() || metadata.len() > 64 * 1024 {
+        return Err("Invalid Live owner binding".into());
+    }
+    let mut bytes = Vec::new();
+    fs::File::open(owner_path).map_err(|_| "Live owner binding unavailable")?
+        .take(64 * 1024 + 1).read_to_end(&mut bytes).map_err(|_| "Live owner binding unavailable")?;
+    if bytes.len() > 64 * 1024 { return Err("Invalid Live owner binding".into()); }
+    let owner: Value = serde_json::from_slice(&bytes).map_err(|_| "Invalid Live owner binding")?;
+    let root = env.get(impeccable_common::design::ROOT_ENV).ok_or("Missing Live project root")?;
+    let root = fs::canonicalize(root).map_err(|_| "Live project root unavailable")?;
+    let project = owner["project_root"].as_str().ok_or("Invalid Live project root")?;
+    let project = fs::canonicalize(project).map_err(|_| "Live project root unavailable")?;
+    let target = owner["root"].as_str().ok_or("Invalid Live app root")?;
+    let target = fs::canonicalize(target).map_err(|_| "Live app root unavailable")?;
+    let cwd = fs::canonicalize(cwd).map_err(|_| "Live app root unavailable")?;
+    if project != root || !target.starts_with(&root) || cwd != target {
+        return Err("Live owner binding belongs to another project or app".into());
+    }
+    match owner.get("design_path") {
+        Some(Value::Null) => Ok(None),
+        Some(Value::String(path)) => {
+            let mut bound = env.clone();
+            bound.insert(impeccable_common::design::PATH_ENV.into(), path.clone());
+            impeccable_common::design::resolve(&cwd.to_string_lossy(), &bound)
+        }
+        _ => Err("Invalid Live design binding".into()),
+    }
+}
+
 pub struct ProjectContext {
